# SignBridge Service — configuration example.
# Copy to .env and edit. Never commit real secrets.

# Root of the existing SignBridge repository. Must contain main.py and
# animation_lib.py, and the Pose/ folder with the 1,917 pre-extracted
# sign pose JSON files.
SIGNBRIDGE_ROOT=C:/Users/kanan/signova-text-to-asl-lab/SignBridge

# Host + port the FastAPI app binds to (localhost-only by default).
HOST=127.0.0.1
PORT=8001

# Dedicated directory where the service writes generated videos.
# Kept separate from the SignBridge repository so the original is untouched.
OUTPUT_DIR=C:/Users/kanan/OneDrive/Desktop/Signova/signbridge-service/outputs

# Request safety limits
# - Max text length (characters) accepted by POST /v1/animations.
# - Max payload size (bytes) accepted by the API.
MAX_TEXT_LENGTH=5000
MAX_REQUEST_SIZE=2097152

# Logging
LOG_LEVEL=info
