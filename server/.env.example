# ---- Signova server environment ----
# Copy to server/.env and fill in. NEVER commit the real .env.

# Server
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS (staff/admin web apps, Expo dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# MongoDB Atlas connection string (SRV form)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/signova?retryWrites=true&w=majority

# JWT secrets — generate strong random values (e.g. `openssl rand -base64 48`)
# ACCESS_TOKEN_TTL must be short (default 15m)
ACCESS_TOKEN_SECRET=change-me-access-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=change-me-refresh-secret
REFRESH_TOKEN_TTL=7d
# Scope-locked challenge / partial tokens for the 2FA step (default 5m)
CHALLENGE_TOKEN_SECRET=change-me-challenge-secret
CHALLENGE_TOKEN_TTL=5m

# AES-256-GCM key used to encrypt stored TOTP secrets (32 bytes, base64 or hex, 64 hex chars)
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Issuer name shown in authenticator apps
APP_NAME=Signova

# Confidence threshold below which a translation is flagged low (0..1)
TRANSLATION_LOW_CONFIDENCE=0.6
