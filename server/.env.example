# ---- Signova server environment ----
# Copy to server/.env and fill in. NEVER commit the real .env.

# Server
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS (staff/admin web apps, Expo dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# MongoDB Atlas connection string (SRV form)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/signova?retryWrites=true&w=majority

# JWT secrets — generate strong random values (e.g. `openssl rand -base64 48`)
# ACCESS_TOKEN_TTL must be short (default 15m)
ACCESS_TOKEN_SECRET=change-me-access-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=change-me-refresh-secret
REFRESH_TOKEN_TTL=7d
# Scope-locked challenge / partial tokens for the 2FA step (default 5m)
CHALLENGE_TOKEN_SECRET=change-me-challenge-secret
CHALLENGE_TOKEN_TTL=5m

# AES-256-GCM key used to encrypt stored TOTP secrets (32 bytes, base64 or hex, 64 hex chars)
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Issuer name shown in authenticator apps
APP_NAME=Signova

# Confidence threshold below which a translation is flagged low (0..1)
TRANSLATION_LOW_CONFIDENCE=0.6

# ---- Password-reset email (Gmail SMTP) — optional at boot ----
# If SMTP_USER / SMTP_APP_PASSWORD are left unset, the server runs normally
# but cannot deliver reset emails; forgot-password fails safely.
# Use a Gmail APP PASSWORD (not your account password):
#   Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-signova-sender@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password

# Trusted base URL of the admin portal, used for first-admin setup links.
# NEVER leave localhost here in production — set your real HTTPS URL.
ADMIN_PORTAL_URL=http://localhost:5173

# Trusted base URL of the staff web app, used to build password-reset links.
# NEVER leave localhost here in production — set your real HTTPS URL.
PASSWORD_RESET_BASE_URL=http://localhost:5173

# Reset-token lifetime in minutes (target: 15)
PASSWORD_RESET_TTL_MINUTES=15

# ---- Text-to-ASL animation service (SignBridge) ----
# Set SIGNBRIDGE_ENABLED=true to generate ASL animations for staff (teller)
# text messages via the local signbridge-service (FastAPI). When disabled or
# the service is down, the backend runs normally and animation status is
# "skipped" — message text is never delayed or blocked.
SIGNBRIDGE_ENABLED=false
# Base URL of the local signbridge-service (never a third party).
SIGNBRIDGE_URL=http://127.0.0.1:8001
# Shared secret for the SignBridge API (sent as X-API-Key). Required when the
# deployed SignBridge service enforces authentication (phase-2 api/main.py).
SIGNBRIDGE_API_KEY=
# Max milliseconds to wait for one animation generation request.
SIGNBRIDGE_TIMEOUT_MS=30000
# Messages longer than this many characters are skipped (no animation).
SIGNBRIDGE_MAX_CHARS=280
# Seconds to retain generated MP4 files before cleanup (default 7 days).
SIGNBRIDGE_VIDEO_RETENTION_SECONDS=604800
# Seconds the circuit breaker stays open after repeated failures before
# probing the service again (default 5 minutes).
SIGNBRIDGE_CIRCUIT_COOLDOWN_SECONDS=300

# ---- Google OAuth (Sign-in with Google) ----
# Copy credentials from Google Cloud Console (Client ID + secret) into these two
# fields, then set GOOGLE_REDIRECT_URI to the verified redirect URI configured
# in the Google Cloud Console.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=change-me-google-client-id
GOOGLE_CLIENT_SECRET=change-me-google-client-secret
# Trusted base URL of the app (where Google redirects after consent).
# MUST match the "Authorized redirect URIs" in the Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google-callback
