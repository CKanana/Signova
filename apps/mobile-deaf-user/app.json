{
  "expo": {
    "name": "Signova",
    "slug": "signova-mobile",
    "scheme": "signova",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "web": {
      "favicon": "./src/assets/signova-brand-assets/favicons/hands-s/favicon-48x48.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Signova uses your camera to help translate sign language during this session.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
     
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 37,
            "targetSdkVersion": 37
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "ke.co.signova.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "ke.co.signova.mobile"
    }
  }
}