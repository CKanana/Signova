{
  "expo": {
    "name": "Signova",
    "slug": "signova-mobile",
    "scheme": "signova",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "favicon": "./src/assets/signova-brand-assets/favicons/hands-s/favicon-48x48.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Signova uses your camera to help translate sign language during this session.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "ke.co.signova.mobile"
    },
    "android": {
      "package": "ke.co.signova.mobile"
    }
  }
}